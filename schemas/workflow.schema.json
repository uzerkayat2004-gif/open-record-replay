{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rrp.dev/schemas/workflow-v1.json",
  "title": "RRP Workflow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "requires",
    "parameters",
    "steps"
  ],
  "properties": {
    "apiVersion": {
      "const": "rrp.dev/v1"
    },
    "kind": {
      "const": "Workflow"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "createdAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "requires": {
      "type": "object",
      "required": [
        "protocol",
        "all"
      ],
      "properties": {
        "protocol": {
          "const": "rrp/1.0"
        },
        "all": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "any": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "string",
              "number",
              "boolean",
              "file",
              "date",
              "secret"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "selector": {
      "type": "object",
      "required": [
        "strategy"
      ],
      "properties": {
        "strategy": {
          "type": "string"
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "weight": {
          "type": "integer"
        }
      }
    },
    "target": {
      "type": "object",
      "required": [
        "candidates",
        "cardinality"
      ],
      "properties": {
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/selector"
          }
        },
        "cardinality": {
          "enum": [
            "one",
            "many",
            "optional"
          ]
        }
      }
    },
    "assertion": {
      "type": "object",
      "required": [
        "assertion"
      ],
      "properties": {
        "assertion": {
          "type": "string"
        },
        "target": {
          "oneOf": [
            {
              "$ref": "#/$defs/target"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "id",
        "action",
        "timeoutMs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "oneOf": [
            {
              "$ref": "#/$defs/target"
            },
            {
              "type": "null"
            }
          ]
        },
        "input": {
          "type": [
            "object",
            "null"
          ]
        },
        "preconditions": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/assertion"
          }
        },
        "postconditions": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/assertion"
          }
        },
        "approval": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "class"
              ],
              "properties": {
                "class": {
                  "enum": [
                    "read",
                    "write",
                    "destructive",
                    "credential",
                    "external-communication",
                    "financial"
                  ]
                },
                "timing": {
                  "enum": [
                    "before",
                    "after"
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000
        }
      }
    }
  }
}
